+// the note instead of a bare timestamp. Prefers the user-given note name, then
+// the first line of an unencrypted note; the two overlay slots get fixed
+// labels. Empty means "no name" - the Apps Script keeps its timestamp default.
+static String sync_display_name(const String &path)
+{
+    // pull the slot number out of "/N.txt"
+    int slot = -1, i = 0;
+    while (i < (int)path.length() && (path[i] < '0' || path[i] > '9'))
