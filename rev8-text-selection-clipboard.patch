+#include <time.h>
+
+// Certificate validation checks the server cert's validity dates against
+// the system clock. The ESP32 has no battery-backed RTC, so it boots at
+// 1970 and every cert then looks "not yet valid" - the TLS handshake
+// fails. Call this once WiFi is up (before any HTTPS request) to pull
+// the real time over NTP. Idempotent: the RTC holds across warm reboots
+// and deep sleep, so it only waits when the clock is still unset.
+static inline void certs_sync_time()
+{
+    time_t now = time(nullptr);
+    if (now > 1700000000) // already set this power cycle (> 2023-11)
+        return;
+
+    configTime(0, 0, "pool.ntp.org", "time.nist.gov", "time.google.com");
+
+    // wait up to ~8s for the first NTP reply; the request will still be
+    // attempted if it times out (validation would then fail loudly)
+    for (int i = 0; i < 80 && time(nullptr) < 1700000000; i++)
+        delay(100);
+}
