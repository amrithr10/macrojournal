diff --git a/micro-journal-rev-4-esp32/src/display/RLCD/MenuBar/MenuBar.cpp b/micro-journal-rev-4-esp32/src/display/RLCD/MenuBar/MenuBar.cpp
new file mode 100644
index 0000000..47a24a1
--- /dev/null
+++ b/micro-journal-rev-4-esp32/src/display/RLCD/MenuBar/MenuBar.cpp
@@ -0,0 +1,567 @@
+#include "MenuBar.h"
+
+#include <Arduino.h>
+#include "app/app.h"
+#include "display/display.h"
+#include "keyboard/keyboard.h"
+
+#include "../WordProcessor/WordProcessor.h"
+#include "../display_RLCD.h"
+#include "service/Crypt/Crypt.h"
+#include "service/Editor/Editor.h"
+#include "service/NoteNames/NoteNames.h"
+
+// ---- actions ------------------------------------------------------------
+enum
+{
+    A_NONE = 0,
+    A_NEW,
+    A_LOCK,
+    A_CLEAR,
+    A_RENAME,
+    A_GRAM,
+    A_SCRATCH,
+    A_WIFI,
+    A_LANG,
+    A_BLE,
+    A_DARK,
+    A_SYNC,
+    A_ABOUT,
+    A_DEVNAME,
+    A_FREESPACE,
+    A_DRIVE,
+    A_RESTART,
+    A_NOTE = 1000 // + slot 0..9 : open that note
+};
+
+// ---- menu model ---------------------------------------------------------
+#define MB_MAX_MENUS 6
+#define MB_MAX_ITEMS 12
+
+struct MBItem
+{
+    char label[18];
+    char shortcut; // letter shown at the right, 0 = none
+    int action;
+};
+struct MBMenu
+{
+    char title[10];
+    MBItem items[MB_MAX_ITEMS];
+    int count;
+};
+
+static MBMenu s_menus[MB_MAX_MENUS];
+static int s_nmenus = 0;
+
+static bool s_active = false;
+static bool s_in_note = true; // opened over the editor (vs the home screen)
+static int s_target = -1;     // note the File menu's Lock/Clear act on
+static int s_menu = 0; // open top menu
+static int s_item = 0; // highlighted item
+static int s_serial = 0;
+
+static void bump() { s_serial++; }
+
+// ---- helpers ------------------------------------------------------------
+static void add_item(MBMenu &m, const char *label, char shortcut, int action)
+{
+    if (m.count >= MB_MAX_ITEMS)
+        return;
+    strncpy(m.items[m.count].label, label, sizeof(m.items[0].label) - 1);
+    m.items[m.count].label[sizeof(m.items[0].label) - 1] = '\0';
+    m.items[m.count].shortcut = shortcut;
+    m.items[m.count].action = action;
+    m.count++;
+}
+
+static MBMenu &add_menu(const char *title)
+{
+    MBMenu &m = s_menus[s_nmenus++];
+    strncpy(m.title, title, sizeof(m.title) - 1);
+    m.title[sizeof(m.title) - 1] = '\0';
+    m.count = 0;
+    return m;
+}
+
+// first line of note `slot`, or "LOCKED"; false when empty/missing
+static bool note_title(int slot, char *buf, int buflen)
+{
+    String path = format("/%d.txt", slot);
+    if (!gfs()->exists(path.c_str()))
+        return false;
+    if (crypt_is_encrypted(path.c_str()))
+    {
+        strncpy(buf, "LOCKED", buflen - 1);
+        buf[buflen - 1] = '\0';
+        return true;
+    }
+    String nm = note_name(slot); // a given name wins over the first-line preview
+    if (!nm.isEmpty())
+    {
+        strncpy(buf, nm.c_str(), buflen - 1);
+        buf[buflen - 1] = '\0';
+        return true;
+    }
+    File f = gfs()->open(path.c_str(), "r");
+    if (!f)
+        return false;
+    char raw[48];
+    int n = f.read((uint8_t *)raw, sizeof(raw) - 1);
+    f.close();
+    if (n <= 0)
+        return false;
+    raw[n] = '\0';
+
+    char *p = raw;
+    while (*p == ' ' || *p == '\n' || *p == '\r' || *p == '>' || *p == '#' || *p == '*')
+        p++;
+    int o = 0;
+    while (*p && *p != '\n' && *p != '\r' && o < buflen - 1)
+    {
+        char c = *p++;
+        if (c >= 32 && c < 127) // menu titles stay ASCII for a clean fit
+            buf[o++] = c;
+    }
+    buf[o] = '\0';
+    return o > 0;
+}
+
+static int first_empty_slot()
+{
+    for (int i = 0; i < 10; i++)
+    {
+        String p = format("/%d.txt", i);
+        if (!gfs()->exists(p.c_str()))
+            return i;
+        File f = gfs()->open(p.c_str(), "r");
+        bool empty = f && f.size() == 0;
+        if (f)
+            f.close();
+        if (empty)
+            return i;
+    }
+    return -1;
+}
+
+static void build_menus()
+{
+    JsonDocument &app = status();
+    s_nmenus = 0;
+
+    // File - Lock/Clear act on the target note (open note, or the selected
+    // home row); shown only when the target is a real note 0-9
+    {
+        MBMenu &m = add_menu("File");
+        add_item(m, "New note", 'N', A_NEW);
+        if (s_target >= 0 && s_target <= 9)
+        {
+            add_item(m, "Rename", 'R', A_RENAME);
+            add_item(m, "Lock / Unlock", 'P', A_LOCK);
+            add_item(m, "Clear", 'C', A_CLEAR);
+        }
+    }
+    // Notes - only non-empty slots
+    {
+        MBMenu &m = add_menu("Notes");
+        for (int i = 0; i < 10; i++)
+        {
+            char t[14];
+            if (note_title(i, t, sizeof(t)))
+            {
+                char lbl[18];
+                snprintf(lbl, sizeof(lbl), "[%d] %s", i, t);
+                add_item(m, lbl, 0, A_NOTE + i);
+            }
+        }
+        if (m.count == 0)
+            add_item(m, "(no notes)", 0, A_NONE);
+    }
+    // Tools
+    {
+        MBMenu &m = add_menu("Tools");
+        add_item(m, "Grammana", 'G', A_GRAM);
+        add_item(m, "Scratchpad", 'S', A_SCRATCH);
+    }
+    // Setup
+    {
+        MBMenu &m = add_menu("Setup");
+        add_item(m, "WiFi", 'W', A_WIFI);
+        add_item(m, "Language", 'L', A_LANG);
+        add_item(m, "BLE keyboard", 'B', A_BLE);
+        char dk[18];
+        snprintf(dk, sizeof(dk), "Dark: %s",
+                 app["config"]["darkmode"].as<bool>() ? "ON" : "OFF");
+        add_item(m, dk, 'I', A_DARK);
+        String url = app["config"]["sync"]["url"].as<String>();
+        if (!url.isEmpty() && url != "null")
+            add_item(m, "Sync", 0, A_SYNC);
+    }
+    // Device
+    {
+        MBMenu &m = add_menu("Device");
+        add_item(m, "About", 0, A_ABOUT);
+        add_item(m, "Device name", 0, A_DEVNAME);
+        add_item(m, "Storage", 0, A_FREESPACE);
+        add_item(m, "Drive mode", 'U', A_DRIVE);
+        add_item(m, "Restart", 0, A_RESTART);
+    }
+}
+
+// ---- dispatch -----------------------------------------------------------
+static void go_menu(int menu_state)
+{
+    JsonDocument &app = status();
+    Editor::getInstance().saveFile();
+    crypt_forget(); // leaving the note re-locks it
+
+    if (s_in_note)
+    {
+        // remember we came from a note so Esc out of the sub-screen returns
+        // there rather than to the home menu; the screen change re-runs the
+        // menu setup which reads "pending"
+        app["menu"]["from_note"] = true;
+        app["menu"]["pending"] = menu_state;
+        app["screen"] = MENUSCREEN;
+    }
+    else
+    {
+        // already on the home menu screen: switch the sub-state directly
+        // (no screen change would fire the setup otherwise)
+        app["menu"]["state"] = menu_state;
+    }
+}
+
+static void dispatch(int action)
+{
+    JsonDocument &app = status();
+    Editor::getInstance().saveFile();
+
+    if (action >= A_NOTE)
+    {
+        WP_openFileGuarded(action - A_NOTE);
+        return;
+    }
+
+    switch (action)
+    {
+    case A_NEW:
+    {
+        int slot = first_empty_slot();
+        if (slot >= 0)
+            WP_openFileGuarded(slot);
+        break;
+    }
+    case A_LOCK:
+        if (s_target >= 0 && s_target <= 9)
+            WP_requestPasswordFor(s_target);
+        break;
+    case A_CLEAR:
+    {
+        int note = s_target;
+        if (note < 0 || note > 9)
+            break;
+        String p = format("/%d.txt", note);
+        bool locked = crypt_is_encrypted(p.c_str()) && !crypt_unlocked_for(p.c_str());
+        if (locked)
+        {
+            // clearing a protected note requires its password (the gate is
+            // itself the confirmation)
+            app["menu"]["clear_return_menu"] = true;
+            WP_requestClearLocked(note);
+        }
+        else if (s_in_note)
+        {
+            // the note we are in is already open and unlocked - empty it in
+            // place (clearFile keeps a *_backup.txt) and step out to home
+            Editor::getInstance().clearFile();
+            crypt_forget();
+            app["screen"] = MENUSCREEN;
+        }
+        else
+        {
+            // let the home screen pop its confirmation dialog for this note
+            app["menu"]["pending_clear"] = note + 1;
+        }
+        break;
+    }
+    case A_RENAME:
+        // hand the slot to the home screen, which owns the name-entry dialog
+        if (s_target >= 0 && s_target <= 9)
+        {
+            app["menu"]["pending_rename"] = s_target + 1;
+            if (s_in_note)
+            {
+                app["menu"]["from_note"] = false;
+                app["menu"]["pending"] = MENU_HOME;
+                app["screen"] = MENUSCREEN;
+            }
+        }
+        break;
+    case A_GRAM:
+        if (s_in_note)
+            WP_openAskClaudeNow();
+        else
+            WP_requestAskClaude(); // from home the screen change loads it
+        break;
+    case A_SCRATCH:
+        if (s_in_note)
+            WP_openScratchpadNow();
+        else
+            WP_requestScratchpad();
+        break;
+    case A_WIFI:
+        go_menu(MENU_WIFI);
+        break;
+    case A_LANG:
+        go_menu(MENU_LAYOUT);
+        break;
+    case A_BLE:
+        Editor::getInstance().saveFile();
+        crypt_forget();
+        app["screen"] = KEYBOARDSCREEN;
+        break;
+    case A_DARK:
+    {
+        bool d = !app["config"]["darkmode"].as<bool>();
+        app["config"]["darkmode"] = d;
+        config_save();
+        display_RLCD_dark(d);
+        break;
+    }
+    case A_SYNC:
+        go_menu(MENU_SYNC);
+        break;
+    case A_ABOUT:
+        go_menu(MENU_INFO);
+        break;
+    case A_FREESPACE:
+        go_menu(MENU_FREESPACE);
+        break;
+    case A_DEVNAME:
+        // hand off to the home screen, which owns the name-entry modal
+        app["menu"]["pending_devname"] = 1;
+        if (s_in_note)
+        {
+            app["menu"]["from_note"] = false;
+            app["menu"]["pending"] = MENU_HOME;
+            app["screen"] = MENUSCREEN;
+        }
+        break;
+    case A_DRIVE:
+        go_menu(MENU_STORAGE);
+        break;
+    case A_RESTART:
+        ESP.restart();
+        break;
+    default:
+        break;
+    }
+}
+
+// ---- public API ---------------------------------------------------------
+void menubar_open(bool in_note, int target_note)
+{
+    if (s_active)
+        return;
+    s_in_note = in_note;
+    s_target = target_note;
+    build_menus();
+    s_active = true;
+    s_menu = 0;
+    s_item = 0;
+    bump();
+}
+
+void menubar_close()
+{
+    if (!s_active)
+        return;
+    s_active = false;
+    bump();
+}
+
+bool menubar_active() { return s_active; }
+int menubar_serial() { return s_serial; }
+
+int menubar_key(int key)
+{
+    if (!s_active)
+        return MB_STAY;
+
+    MBMenu &mn = s_menus[s_menu];
+
+    if (key == 27) // Esc, or Shift+Esc
+        return keyboard_shift_pressed() ? MB_TO_NOTE : MB_TO_HOME;
+
+    if (key == 18) // left
+    {
+        s_menu = (s_menu - 1 + s_nmenus) % s_nmenus;
+        s_item = 0;
+        bump();
+        return MB_STAY;
+    }
+    if (key == 19) // right
+    {
+        s_menu = (s_menu + 1) % s_nmenus;
+        s_item = 0;
+        bump();
+        return MB_STAY;
+    }
+    if (key == 20) // up
+    {
+        if (mn.count)
+            s_item = (s_item - 1 + mn.count) % mn.count;
+        bump();
+        return MB_STAY;
+    }
+    if (key == 21) // down
+    {
+        if (mn.count)
+            s_item = (s_item + 1) % mn.count;
+        bump();
+        return MB_STAY;
+    }
+    if (key == '\n')
+    {
+        if (mn.count && mn.items[s_item].action != A_NONE)
+        {
+            dispatch(mn.items[s_item].action);
+            return MB_DISPATCHED;
+        }
+        return MB_STAY;
+    }
+
+    // a bracket-letter shortcut fires its item from anywhere in the bar
+    int up = (key >= 'a' && key <= 'z') ? key - 32 : key;
+    for (int m = 0; m < s_nmenus; m++)
+        for (int i = 0; i < s_menus[m].count; i++)
+            if (s_menus[m].items[i].shortcut == up &&
+                s_menus[m].items[i].action != A_NONE)
+            {
+                dispatch(s_menus[m].items[i].action);
+                return MB_DISPATCHED;
+            }
+
+    return MB_STAY;
+}
+
+// ---- rendering ----------------------------------------------------------
+static const int MB_TITLE_X0 = 18; // left inset clears the rounded corner
+static const int MB_TITLE_GAP = 12;
+static const int MB_CHAR_W = 12; // profont22 native advance (bar titles)
+
+// draw a string one glyph at a time on a fixed cell pitch, so every
+// character sits in an equal `cw`-wide column with room to breathe (plain
+// u8->print packs glyphs at the font's tight 12px advance). Declared in
+// MenuBar.h and shared with the home screen so the whole UI reads the same.
+//
+// The panel stores the horizontal axis at half resolution: writePhysicalPoint
+// maps real_y = x/2, so logical columns (2k, 2k+1) collapse into one physical
+// column. A ~2px vertical stroke therefore renders 1px wide when it starts on
+// an even column and 2px (visibly bold) when it starts on an odd one. Pin the
+// origin to an even column - and keep cw even (14) - so every glyph downsamples
+// on the same phase everywhere, instead of the same letter looking heavier in
+// one menu than another just because its box landed on a different x.
+void ui_print_tracked(U8G2_FOR_ST73XX *u8, int x, int y, const char *s, int cw)
+{
+    x &= ~1; // snap to an even column so the x/2 downsample phase is uniform
+    char ch[2] = {0, 0};
+    for (const char *p = s; *p; ++p)
+    {
+        ch[0] = *p;
+        u8->setCursor(x, y);
+        u8->print(ch);
+        x += cw;
+    }
+}
+
+void menubar_render(ST7305_4p2_BW_DisplayDriver *display, U8G2_FOR_ST73XX *u8)
+{
+    if (!s_active)
+        return;
+
+    u8->setFont(u8g2_font_profont22_tf);
+
+    // opaque bar + separator line
+    display->drawFilledRectangle(0, 0, 399, 24, ST7305_COLOR_WHITE);
+    display->drawLine(0, 25, 399, 25, ST7305_COLOR_BLACK);
+
+    // titles, remembering where the open one sits
+    int x = MB_TITLE_X0;
+    int open_x = MB_TITLE_X0;
+    for (int m = 0; m < s_nmenus; m++)
+    {
+        int w = (int)strlen(s_menus[m].title) * MB_CHAR_W;
+        if (m == s_menu)
+        {
+            display->drawFilledRectangle(x - 3, 0, x + w + 2, 24, ST7305_COLOR_BLACK);
+            u8->setForegroundColor(0);
+            u8->setBackgroundColor(1);
+            u8->setCursor(x, 20);
+            u8->print(s_menus[m].title);
+            u8->setForegroundColor(1);
+            u8->setBackgroundColor(0);
+            open_x = x;
+        }
+        else
+        {
+            u8->setCursor(x, 20);
+            u8->print(s_menus[m].title);
+        }
+        x += w + MB_TITLE_GAP;
+    }
+
+    // dropdown for the open menu
+    MBMenu &mn = s_menus[s_menu];
+    int boxw = 0;
+    for (int i = 0; i < mn.count; i++)
+    {
+        int lw = (int)strlen(mn.items[i].label) * UI_TRACK_CW;
+        if (mn.items[i].shortcut)
+            lw += 36;
+        if (lw > boxw)
+            boxw = lw;
+    }
+    boxw += 22; // box is exactly as wide as its own content needs
+
+    // open each dropdown under its own title; clamp only if it would run off
+    // the right edge of the screen
+    int boxx = open_x - 3;
+    if (boxx + boxw > 396)
+        boxx = 396 - boxw;
+    if (boxx < 2)
+        boxx = 2;
+
+    const int rowh = 26;
+    int boxy = 25;
+    int boxh = mn.count * rowh + 6;
+
+    display->drawFilledRectangle(boxx, boxy, boxx + boxw, boxy + boxh, ST7305_COLOR_WHITE);
+    display->drawRectangle(boxx, boxy, boxx + boxw, boxy + boxh, ST7305_COLOR_BLACK);
+
+    for (int i = 0; i < mn.count; i++)
+    {
+        int ry = boxy + 4 + i * rowh;
+        int baseline = ry + 19;
+        bool hi = (i == s_item);
+        if (hi)
+        {
+            display->drawFilledRectangle(boxx + 2, ry, boxx + boxw - 2, ry + rowh - 2,
+                                         ST7305_COLOR_BLACK);
+            u8->setForegroundColor(0);
+            u8->setBackgroundColor(1);
+        }
+        ui_print_tracked(u8, boxx + 10, baseline, mn.items[i].label, UI_TRACK_CW);
+        if (mn.items[i].shortcut)
+        {
+            char sc[2] = {mn.items[i].shortcut, 0};
+            ui_print_tracked(u8, boxx + boxw - 22, baseline, sc, UI_TRACK_CW);
+        }
+        if (hi)
+        {
+            u8->setForegroundColor(1);
+            u8->setBackgroundColor(0);
+        }
+    }
+}
