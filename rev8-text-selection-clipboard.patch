+
+// The file pane lists the two built-in tools (Scratchpad = slot 10,
+// Grammana Z = slot 11) pinned at the top, then the ten notes (0-9)
+// below in a scrolling window.
+//
+// Traverse mode ([F]) walks a single 12-item list:
+//   0 = Scratchpad, 1 = Grammana Z, 2..11 = notes 0..9
+// The two tools stay put; only the notes scroll, keeping the highlight
+// in view. Enter opens the item; D/P act on notes only.
+#define TRAV_COUNT 12
+#define NOTE_VIS 8 // notes visible at once (10 total -> 2 can scroll)
+
+static bool trav_is_tool(int t) { return t == 0 || t == 1; }
+static int trav_note(int t) { return t - 2; } // valid when t >= 2
+
+// -1 = traverse off, else the highlighted position 0..11. Sticky: acting
+// on a file (or visiting one) and returning restores the highlight; only
+// ESC or F turn it off.
+static int traverse = -1;
+static bool traverse_stick = false;
+
+// first visible note in the scrolling window (0..2)
+static int note_scroll = 0;
+
+// First line of each note, shown as its title. Loaded when the home
+// screen opens; 10 tiny reads are instant on the FAT.
+static char file_titles[10][13];
+
+// [N]: rename the device - the toolbar title, typed into the header bar
+static bool naming = false;
+static char name_buf[13];
+static int name_len = 0;
+
+// keep the highlighted note inside the scroll window
+static void ensure_note_visible(int note)
+{
+    if (note < note_scroll)
+        note_scroll = note;
+    else if (note >= note_scroll + NOTE_VIS)
+        note_scroll = note - NOTE_VIS + 1;
+
+    if (note_scroll < 0)
+        note_scroll = 0;
+    if (note_scroll > 10 - NOTE_VIS)
+        note_scroll = 10 - NOTE_VIS;
+}
+
+static void home_load_titles()
+{
+    for (int i = 0; i < 10; i++)
+    {
+        file_titles[i][0] = '\0';
+
+        String path = format("/%d.txt", i);
+        if (!gfs()->exists(path.c_str()))
+            continue;
+
+        // protected files never leak their first line
+        if (crypt_is_encrypted(path.c_str()))
+        {
+            strcpy(file_titles[i], "LOCKED");
+            continue;
+        }
+
+        File file = gfs()->open(path.c_str(), "r");
+        if (!file)
+            continue;
+
+        char raw[64];
+        int n = file.read((uint8_t *)raw, sizeof(raw) - 1);
+        file.close();
+        if (n <= 0)
+            continue;
+        raw[n] = '\0';
+
+        // skip leading whitespace and markdown markers so the title reads
+        // clean even when the note starts with "> " or "**"
+        char *psrc = raw;
+        while (*psrc == ' ' || *psrc == '\n' || *psrc == '\r' ||
+               *psrc == '>' || *psrc == '#' || *psrc == '*')
+            psrc++;
+
+        // copy the rest of the first line, whole UTF-8 characters only
+        int out = 0;
+        while (*psrc && *psrc != '\n' && *psrc != '\r')
+        {
+            uint8_t b = (uint8_t)*psrc;
+            int len = 1;
+            if ((b & 0xE0) == 0xC0) len = 2;
+            else if ((b & 0xF0) == 0xE0) len = 3;
+            else if ((b & 0xF8) == 0xF0) len = 4;
+
+            if (out + len > (int)sizeof(file_titles[0]) - 1)
+                break;
+
+            // the 64-byte probe may end mid-character - stop cleanly
+            bool complete = true;
+            for (int k = 1; k < len; k++)
+                if (((uint8_t)psrc[k] & 0xC0) != 0x80)
+                {
+                    complete = false;
+                    break;
+                }
+            if (!complete)
+                break;
+
+            for (int k = 0; k < len; k++)
+                file_titles[i][out++] = psrc[k];
+            psrc += len;
+        }
+        file_titles[i][out] = '\0';
+    }
+}
 
