+//
+// UNDO / REDO
+//
+// Coalescing: markDirty() timestamps every buffer mutation; historyCommit()
+// (driven off the idle timer in loop(), and forced before undo/redo) folds a
+// settled burst of edits into a single undo step. Snapshots are whole-buffer
+// copies - simple and impossible to desync from the real buffer, at the cost
+// of some RAM, which the per-stack entry and byte caps bound.
+
+// heap copy of a buffer slice, NUL-terminated. nullptr on OOM.
+char *Editor::historyDup(const char *src, int len)
+{
+    char *p = (char *)malloc(len + 1);
+    if (!p)
+        return nullptr;
+    memcpy(p, src, len);
+    p[len] = '\0';
+    return p;
+}
+
+// push onto a stack (newest on top), evicting the oldest entries to stay
+// within both the count and the byte budget
+void Editor::historyPush(UndoState *stack, int &count, size_t &bytes,
+                         char *text, int len, int cursor)
+{
+    if (!text)
+        return;
+
+    // full: drop the oldest
+    if (count >= UNDO_MAX)
+    {
+        free(stack[0].text);
+        bytes -= stack[0].len;
+        memmove(stack, stack + 1, sizeof(UndoState) * (UNDO_MAX - 1));
+        count--;
+    }
+
+    // over budget: keep dropping the oldest (always leave at least this one)
+    while (count > 0 && bytes + (size_t)len > UNDO_BUDGET)
+    {
+        free(stack[0].text);
+        bytes -= stack[0].len;
+        memmove(stack, stack + 1, sizeof(UndoState) * (count - 1));
+        count--;
+    }
+
+    stack[count].text = text;
+    stack[count].len = len;
+    stack[count].cursorPos = cursor;
+    count++;
+    bytes += len;
+}
+
+void Editor::historyClearStack(UndoState *stack, int &count, size_t &bytes)
+{
+    for (int i = 0; i < count; i++)
+        free(stack[i].text);
+    count = 0;
+    bytes = 0;
+}
+
+// overwrite the live buffer with a snapshot
+void Editor::historyRestore(const char *text, int len, int cursor)
+{
+    if (len > BUFFER_SIZE)
+        len = BUFFER_SIZE;
+
+    memcpy(buffer, text, len);
+    buffer[len] = '\0';
+
+    cursorPos = cursor;
+    if (cursorPos > len)
+        cursorPos = len;
+    if (cursorPos < 0)
+        cursorPos = 0;
+
+    composer.reset();
+    clearSelection();
+}
+
+// baseline = current buffer, discard all history. Called whenever the
+// window is (re)loaded so snapshots never cross a window boundary.
+void Editor::historyReset()
+{
+    historyClearStack(undoStack, undoCount, undoBytes);
+    historyClearStack(redoStack, redoCount, redoBytes);
+
+    free(undoBaseline);
+    int len = getBufferSize();
+    undoBaseline = historyDup(buffer, len);
+    undoBaselineLen = undoBaseline ? len : 0;
+    undoBaselineCursor = cursorPos;
+    undoDirty = false;
+}
+
+// a mutation happened - remember when, so the burst can settle
+void Editor::markDirty()
+{
+    undoDirty = true;
+    undoLastEdit = millis();
+}
+
+// fold a settled edit burst into one undo step. No-op if nothing changed.
+void Editor::historyCommit()
+{
+    if (!undoDirty)
+        return;
+
+    // nothing actually changed (e.g. typed then deleted back to baseline)
+    if (undoBaseline && strcmp(undoBaseline, buffer) == 0)
+    {
+        undoDirty = false;
+        return;
+    }
+
+    // the pre-burst baseline becomes an undo step (ownership transferred)
+    if (undoBaseline)
+        historyPush(undoStack, undoCount, undoBytes,
+                    undoBaseline, undoBaselineLen, undoBaselineCursor);
+
+    // a fresh edit invalidates the redo history
+    historyClearStack(redoStack, redoCount, redoBytes);
+
+    // new baseline is the current buffer
+    int len = getBufferSize();
+    undoBaseline = historyDup(buffer, len);
+    undoBaselineLen = undoBaseline ? len : 0;
+    undoBaselineCursor = cursorPos;
+    undoDirty = false;
+}
