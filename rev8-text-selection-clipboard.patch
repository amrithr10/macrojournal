+
+// baseline = current buffer, discard all history. Called whenever the
+// window is (re)loaded so snapshots never cross a window boundary.
+void Editor::historyReset()
+{
+    historyClearStack(undoStack, undoCount, undoBytes);
+    historyClearStack(redoStack, redoCount, redoBytes);
