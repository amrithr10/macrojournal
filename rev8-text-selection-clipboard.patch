diff --git a/micro-journal-rev-4-esp32/src/service/AskClaude/AskClaude.cpp b/micro-journal-rev-4-esp32/src/service/AskClaude/AskClaude.cpp
new file mode 100644
index 0000000..d1083f1
--- /dev/null
+++ b/micro-journal-rev-4-esp32/src/service/AskClaude/AskClaude.cpp
@@ -0,0 +1,602 @@
+#include "AskClaude.h"
+#include "app/app.h"
+
+//
+#include "service/Editor/Editor.h"
+#include "service/WifiEntry/WifiEntry.h"
+
+//
+#include <WiFi.h>
+#include <HTTPClient.h>
+
+// state shared between the display core (request/poll) and the background
+// core (worker). The int is written by one side at a time; String fields
+// are only touched while the state machine guarantees the other side
+// isn't reading them (snapshot before BUSY, answer after BUSY).
+static volatile int _state = ASK_IDLE;
+static String _status_text = "";
+static String _prompt = ""; // buffer snapshot taken at request time
+static String _answer = "";
+static volatile bool _answer_ready = false;
+
+// request modes: a conversation from the ask screen, or a grammar review
+// (issue list or full rewrite) of text handed over by the display
+#define MODE_CONVERSATION 0
+#define MODE_GRAMMAR 1
+#define MODE_REWRITE 2
+
+// LLM providers - the config picks one by an explicit "provider" field or,
+// failing that, by whichever provider key is present
+#define PROV_ANTHROPIC 0
+#define PROV_OPENAI 1
+#define PROV_GEMINI 2
+static volatile int _mode = MODE_CONVERSATION;
+static volatile bool _answer_grammar = false;
+
+// /claude.json
+static String _api_key = "";
+static String _model = "claude-opus-4-8";
+static int _max_tokens = 1024;
+static String _system = "";
+static String _grammar_system = "";
+static String _rewrite_system = "";
+static int _provider = PROV_ANTHROPIC;
+static String _default_model = "claude-opus-4-8";
+
+// default reviewer instructions; override with "grammar_system" in claude.json
+static const char *GRAMMAR_SYSTEM_DEFAULT =
+    "You are a careful copy editor. The user sends a piece of writing from a "
+    "small plain-text writing device. List the grammar, spelling and "
+    "punctuation problems. For each issue, on its own numbered line: quote "
+    "the problem phrase, say in a few words what is wrong, then give the "
+    "corrected phrase. Plain text only - no markdown. Skip sentences that "
+    "are fine. End with one short line on overall quality. If there are no "
+    "issues, just say the text looks clean.";
+
+// override with "rewrite_system" in claude.json
+static const char *REWRITE_SYSTEM_DEFAULT =
+    "You are a careful copy editor. The user sends a piece of writing from a "
+    "small plain-text writing device. Rewrite it with grammar, spelling and "
+    "punctuation corrected. Preserve the writer's voice, wording, line "
+    "breaks and any *emphasis* markers - fix only what is wrong, never "
+    "paraphrase or improve style. Output ONLY the corrected text: no "
+    "preamble, no commentary, no markdown fences.";
+
+//
+int askclaude_status() { return _state; }
+const char *askclaude_status_text() { return _status_text.c_str(); }
+void askclaude_clear_error()
+{
+    if (_state == ASK_ERROR)
+        _state = ASK_IDLE;
+}
+bool askclaude_answer_ready() { return _answer_ready; }
+bool askclaude_answer_is_grammar() { return _answer_grammar; }
+String askclaude_take_answer()
+{
+    _answer_ready = false;
+    return _answer;
+}
+
+//
+static void ask_fail(const char *message)
+{
+    _status_text = message;
+    _state = ASK_ERROR;
+    _log("[askclaude] error: %s\n", message);
+}
+
+// load /claude.json from the drive
+static bool ask_load_config()
+{
+    if (!gfs()->exists("/claude.json"))
+    {
+        ask_fail("NO claude.json");
+        return false;
+    }
+
+    File file = gfs()->open("/claude.json", "r");
+    if (!file)
+    {
+        ask_fail("claude.json OPEN FAIL");
+        return false;
+    }
+
+    JsonDocument doc;
+    DeserializationError err = deserializeJson(doc, file);
+    file.close();
+
+    if (err)
+    {
+        ask_fail("claude.json BAD JSON");
+        return false;
+    }
+
+    _max_tokens = doc["max_tokens"] | 1024;
+    _system = doc["system"] | "";
+    _grammar_system = doc["grammar_system"] | GRAMMAR_SYSTEM_DEFAULT;
+    _rewrite_system = doc["rewrite_system"] | REWRITE_SYSTEM_DEFAULT;
+
+    // "api_key" is the Anthropic key (backward compatible); each provider
+    // also has its own named field
+    String anthropicKey = doc["anthropic_api_key"] | (doc["api_key"] | "");
+    String openaiKey = doc["openai_api_key"] | "";
+    String geminiKey = doc["gemini_api_key"] | "";
+
+    // explicit provider, else auto-detect by whichever key is filled in
+    String provider = doc["provider"] | "";
+    provider.toLowerCase();
+    if (provider.length() == 0)
+    {
+        if (anthropicKey.length() >= 10)
+            provider = "anthropic";
+        else if (openaiKey.length() >= 10)
+            provider = "openai";
+        else if (geminiKey.length() >= 10)
+            provider = "gemini";
+    }
+
+    if (provider == "openai")
+    {
+        _provider = PROV_OPENAI;
+        _api_key = openaiKey.length() ? openaiKey : anthropicKey;
+        _default_model = "gpt-4o-mini";
+    }
+    else if (provider == "gemini" || provider == "google")
+    {
+        _provider = PROV_GEMINI;
+        _api_key = geminiKey.length() ? geminiKey : anthropicKey;
+        _default_model = "gemini-2.0-flash";
+    }
+    else
+    {
+        _provider = PROV_ANTHROPIC;
+        _api_key = anthropicKey;
+        _default_model = "claude-opus-4-8";
+    }
+
+    // "model" overrides the provider default
+    String model = doc["model"] | "";
+    _model = model.length() ? model : _default_model;
+
+    if (_api_key.length() < 10)
+    {
+        ask_fail("NO API KEY");
+        return false;
+    }
+
+    _log("[askclaude] provider %d model %s\n", _provider, _model.c_str());
+    return true;
+}
+
+// Split the buffer snapshot into conversation turns. Blocks separated by
+// lines containing exactly "---" alternate user / assistant / user...
+// Returns false (with an error set) when there is nothing to ask.
+static bool ask_build_messages(JsonArray messages)
+{
+    int start = 0;
+    int length = _prompt.length();
+    String block = "";
+    int role = 0; // 0 = user, 1 = assistant
+
+    auto flushBlock = [&]() {
+        block.trim();
+        if (block.length() > 0)
+        {
+            JsonObject msg = messages.add<JsonObject>();
+            msg["role"] = role == 0 ? "user" : "assistant";
+            msg["content"] = block;
+            role = 1 - role;
+        }
+        block = "";
+    };
+
+    while (start <= length)
+    {
+        int nl = _prompt.indexOf('\n', start);
+        String line = (nl < 0) ? _prompt.substring(start)
+                               : _prompt.substring(start, nl);
+
+        String trimmed = line;
+        trimmed.trim();
+
+        if (trimmed == "---")
+            flushBlock();
+        else
+        {
+            block += line;
+            block += '\n';
+        }
+
+        if (nl < 0)
+            break;
+        start = nl + 1;
+    }
+    flushBlock();
+
+    if (messages.size() == 0)
+    {
+        ask_fail("NOTHING TO ASK");
+        return false;
+    }
+
+    // the API requires the conversation to end on a user turn - hitting
+    // send right after an answer (without typing a new question) would
+    // otherwise be rejected as a prefill
+    JsonObject last = messages[messages.size() - 1];
+    if (strcmp(last["role"], "user") != 0)
+    {
+        ask_fail("TYPE A QUESTION FIRST");
+        return false;
+    }
+
+    return true;
+}
+
+// connect to a saved WiFi network - same scan-and-match approach as Sync,
+// without the sync screen messaging
+static bool ask_connect_wifi()
+{
+    JsonDocument &app = status();
+
+    // wifi.json is NOT loaded at boot - the sync/wifi menu screens load it
+    // on entry. Load it here so Ask Claude works without visiting a menu.
+    wifi_config_load();
+
+    JsonArray savedAccessPoints = app["wifi"]["access_points"].as<JsonArray>();
+    if (savedAccessPoints.isNull() || savedAccessPoints.size() == 0)
+    {
+        ask_fail("NO WIFI CONFIG");
+        return false;
+    }
+
+    setCpuFrequencyMhz(CPU_FREQUENCY_FULL);
+
+    WiFi.mode(WIFI_STA);
+    WiFi.setHostname("MICROJOURNAL");
+
+    // give the radio time to come up before scanning (same wait Sync uses -
+    // scanning too early returns an empty list)
+    delay(3000);
+
+    int networksFound = WiFi.scanNetworks();
+    if (networksFound <= 0)
+    {
+        // one retry - first scan after power-up occasionally comes back empty
+        delay(1000);
+        networksFound = WiFi.scanNetworks();
+    }
+    _log("[askclaude] found %d networks\n", networksFound);
+
+    for (int i = 0; i < networksFound; i++)
+    {
+        String availableSsid = WiFi.SSID(i);
+
+        for (JsonVariant savedAccessPoint : savedAccessPoints)
+        {
+            const char *savedSsid = savedAccessPoint["ssid"];
+            const char *savedPassword = savedAccessPoint["password"];
+
+            if (savedSsid == nullptr ||
+                strcmp(availableSsid.c_str(), savedSsid) != 0)
+                continue;
+
+            _log("[askclaude] connecting to %s\n", savedSsid);
+            WiFi.begin(savedSsid, savedPassword);
+
+            int attempt = 0;
+            while (WiFi.status() != WL_CONNECTED && attempt < 100)
+            {
+                delay(100);
+                attempt++;
+            }
+
+            if (WiFi.status() == WL_CONNECTED)
+            {
+                _log("[askclaude] connected: %s\n",
+                     WiFi.localIP().toString().c_str());
+                return true;
+            }
+
+            // try the remaining saved networks
+            WiFi.disconnect();
+        }
+    }
+
+    return false;
+}
+
+// power the radio down again (same as sync_stop)
+static void ask_wifi_off()
+{
+    WiFi.disconnect(true);
+    WiFi.mode(WIFI_OFF);
+    setCpuFrequencyMhz(CPU_FREQUENCY_LOW);
+}
+
+// the blocking worker - runs on the background core
+static void ask_run()
+{
+    _status_text = (_mode == MODE_REWRITE)   ? "REWRITING (WIFI)..."
+                   : (_mode == MODE_GRAMMAR) ? "CHECKING (WIFI)..."
+                                             : "ASKING (WIFI)...";
+
+    if (!ask_load_config())
+        return;
+
+    // a rewrite must be able to return the whole corrected text, so give
+    // it output room proportional to the input (~1 token per 3 bytes,
+    // with slack), never less than the configured max_tokens
+    int maxTokens = _max_tokens;
+    if (_mode == MODE_REWRITE)
+    {
+        int needed = (int)_prompt.length() / 3 + 256;
+        if (needed > maxTokens)
+            maxTokens = needed;
+        if (maxTokens > 6000)
+            maxTokens = 6000;
+    }
+
+    // Build a provider-neutral conversation (role = user/assistant) plus
+    // the system prompt for this mode; the provider render below turns it
+    // into the right JSON shape.
+    JsonDocument convDoc;
+    JsonArray conv = convDoc.to<JsonArray>();
+    String systemPrompt;
+
+    if (_mode == MODE_GRAMMAR || _mode == MODE_REWRITE)
+    {
+        String text = _prompt;
+        text.trim();
+        if (text.length() == 0)
+        {
+            ask_fail("NOTHING TO CHECK");
+            return;
+        }
+        systemPrompt = (_mode == MODE_REWRITE) ? _rewrite_system : _grammar_system;
+        JsonObject o = conv.add<JsonObject>();
+        o["role"] = "user";
+        o["content"] = text;
+    }
+    else
+    {
+        systemPrompt = _system;
+        if (!ask_build_messages(conv))
+            return;
+    }
+
+    // Render the provider-specific request body, endpoint and auth.
+    JsonDocument req;
+    String url;
+
+    if (_provider == PROV_OPENAI)
+    {
+        // OpenAI chat completions: system is a leading "system" message
+        req["model"] = _model;
+        req["max_tokens"] = maxTokens;
+        JsonArray m = req["messages"].to<JsonArray>();
+        if (systemPrompt.length())
+        {
+            JsonObject s = m.add<JsonObject>();
+            s["role"] = "system";
+            s["content"] = systemPrompt;
+        }
+        for (JsonObject src : conv)
+        {
+            JsonObject o = m.add<JsonObject>();
+            o["role"] = src["role"];
+            o["content"] = src["content"];
+        }
+        url = "https://api.openai.com/v1/chat/completions";
+    }
+    else if (_provider == PROV_GEMINI)
+    {
+        // Gemini: "contents" with role user/model, separate systemInstruction
+        if (systemPrompt.length())
+            req["systemInstruction"]["parts"][0]["text"] = systemPrompt;
+        JsonArray c = req["contents"].to<JsonArray>();
+        for (JsonObject src : conv)
+        {
+            JsonObject o = c.add<JsonObject>();
+            const char *role = src["role"].as<const char *>();
+            o["role"] = (role && strcmp(role, "assistant") == 0) ? "model" : "user";
+            o["parts"][0]["text"] = src["content"];
+        }
+        req["generationConfig"]["maxOutputTokens"] = maxTokens;
+        url = "https://generativelanguage.googleapis.com/v1beta/models/" +
+              _model + ":generateContent";
+    }
+    else
+    {
+        // Anthropic messages
+        req["model"] = _model;
+        req["max_tokens"] = maxTokens;
+        if (systemPrompt.length())
+            req["system"] = systemPrompt;
+        JsonArray m = req["messages"].to<JsonArray>();
+        for (JsonObject src : conv)
+        {
+            JsonObject o = m.add<JsonObject>();
+            o["role"] = src["role"];
+            o["content"] = src["content"];
+        }
+        url = "https://api.anthropic.com/v1/messages";
+    }
+
+    String body;
+    serializeJson(req, body);
+    req.clear();
+    convDoc.clear();
+
+    //
+    if (!ask_connect_wifi())
+    {
+        ask_wifi_off();
+        // keep a more specific error (NO WIFI CONFIG) if one was already set
+        if (_state != ASK_ERROR)
+            ask_fail("NO WIFI");
+        return;
+    }
+
+    _status_text = (_mode == MODE_REWRITE)   ? "REWRITING..."
+                   : (_mode == MODE_GRAMMAR) ? "CHECKING..."
+                                             : "ASKING...";
+
+    // the HTTPS request. HTTPClient::begin(url) with an https URL uses
+    // TLS without certificate pinning - same approach the Sync service
+    // uses for Google Drive.
+    HTTPClient http;
+    http.begin(url);
+    http.setConnectTimeout(15000);
+    http.setTimeout(60000);
+    http.addHeader("Content-Type", "application/json");
+    if (_provider == PROV_OPENAI)
+        http.addHeader("Authorization", "Bearer " + _api_key);
+    else if (_provider == PROV_GEMINI)
+        http.addHeader("x-goog-api-key", _api_key);
+    else
+    {
+        http.addHeader("x-api-key", _api_key);
+        http.addHeader("anthropic-version", "2023-06-01");
+    }
+
+    int code = http.POST(body);
+    String response = (code > 0) ? http.getString() : "";
+    http.end();
+    ask_wifi_off();
+
+    _log("[askclaude] HTTP %d, %d bytes\n", code, response.length());
+
+    if (code <= 0)
+    {
+        ask_fail("CONNECTION FAILED");
+        return;
+    }
+
+    JsonDocument responseDoc;
+    if (deserializeJson(responseDoc, response))
+    {
+        ask_fail(format("HTTP %d (BAD JSON)", code).c_str());
+        return;
+    }
+
+    if (code != 200)
+    {
+        // surface whatever the provider names the failure
+        const char *type = responseDoc["error"]["type"] | "";
+        if (!type[0])
+            type = responseDoc["error"]["status"] | "";
+        String detail = type[0] ? String(type)
+                                : String((const char *)(responseDoc["error"]["message"] | ""));
+        if (detail.length() > 24)
+            detail = detail.substring(0, 24);
+        ask_fail(format("HTTP %d %s", code, detail.c_str()).c_str());
+        return;
+    }
+
+    // extract the answer text per provider
+    String answer = "";
+    bool truncated = false;
+
+    if (_provider == PROV_OPENAI)
+    {
+        JsonObject choice = responseDoc["choices"][0];
+        answer = (const char *)(choice["message"]["content"] | "");
+        truncated = strcmp(choice["finish_reason"] | "", "length") == 0;
+    }
+    else if (_provider == PROV_GEMINI)
+    {
+        JsonObject cand = responseDoc["candidates"][0];
+        for (JsonVariant part : cand["content"]["parts"].as<JsonArray>())
+            answer += (const char *)(part["text"] | "");
+        truncated = strcmp(cand["finishReason"] | "", "MAX_TOKENS") == 0;
+        if (answer.length() == 0)
+        {
+            const char *blocked = responseDoc["promptFeedback"]["blockReason"] | "";
+            if (blocked[0])
+            {
+                ask_fail("BLOCKED");
+                return;
+            }
+        }
+    }
+    else
+    {
+        const char *stopReason = responseDoc["stop_reason"] | "";
+        if (strcmp(stopReason, "refusal") == 0)
+        {
+            ask_fail("REFUSED");
+            return;
+        }
+        for (JsonVariant blockVar : responseDoc["content"].as<JsonArray>())
+        {
+            if (strcmp(blockVar["type"] | "", "text") == 0)
+                answer += (const char *)(blockVar["text"] | "");
+        }
+        truncated = strcmp(stopReason, "max_tokens") == 0;
+    }
+
+    if (answer.length() == 0)
+    {
+        ask_fail("EMPTY ANSWER");
+        return;
+    }
+
+    if (truncated)
+        answer += "\n[cut off - raise max_tokens in claude.json]";
+
+    _answer = answer;
+    _answer_grammar = (_mode != MODE_CONVERSATION);
+    _answer_ready = true;
+    _status_text = "";
+    _state = ASK_IDLE;
+}
+
+// display side: snapshot the text and hand the work to the background core
+static void askclaude_queue(int mode, const char *statusText, const char *text)
+{
+    if (_state == ASK_BUSY)
+        return;
+
+    // snapshot now so typing during the request can't tear the prompt
+    _prompt = text ? text : Editor::getInstance().buffer;
+    _mode = mode;
+    _answer_ready = false;
+    _status_text = statusText;
+    _state = ASK_BUSY;
+
+    JsonDocument &app = status();
+    app["task"] = "ask_claude";
+
+    _log("[askclaude] request queued, mode %d (%d bytes)\n", mode, _prompt.length());
+}
+
+void askclaude_request()
+{
+    askclaude_queue(MODE_CONVERSATION, "ASKING...", nullptr);
+}
+
+void askclaude_review_request(const char *text, bool rewrite)
+{
+    askclaude_queue(rewrite ? MODE_REWRITE : MODE_GRAMMAR,
+                    rewrite ? "REWRITING..." : "CHECKING...", text);
+}
+
+// background core: pick up the queued request (same pattern as sync_loop)
+void askclaude_loop()
+{
+    static unsigned int last = 0;
+    if (millis() - last > 500)
+    {
+        last = millis();
+
+        JsonDocument &app = status();
+        String task = app["task"].as<String>();
+
+        if (task == "ask_claude")
+        {
+            app["task"] = "";
+            ask_run();
+        }
+    }
+}
diff --git a/micro-journal-rev-4-esp32/src/service/AskClaude/AskClaude.h b/micro-journal-rev-4-esp32/src/service/AskClaude/AskClaude.h
new file mode 100644
index 0000000..c02ec6f
--- /dev/null
+++ b/micro-journal-rev-4-esp32/src/service/AskClaude/AskClaude.h
@@ -0,0 +1,39 @@
+#pragma once
+
+#include <Arduino.h>
+
+// Ask Claude: send the current editor buffer (the "/11.txt" ask screen) as
+// a conversation to the Anthropic API and append the answer to the buffer.
+//
+// The request runs on the background core via the app["task"] mechanism
+// (same as Sync), so typing and the display stay responsive. The display
+// side polls askclaude_answer_ready() and injects the answer into the
+// editor buffer on its own core.
+//
+// Configuration lives in /claude.json on the drive:
+//   { "api_key": "sk-ant-...", "model": "claude-opus-4-8",
+//     "max_tokens": 1024, "system": "..." }
+//
+// The conversation format inside the buffer: blocks separated by lines
+// containing exactly "---" alternate between user and assistant, starting
+// with user. Everything in the buffer is sent, so follow-up questions
+// carry their context.
+
+#define ASK_IDLE 0
+#define ASK_BUSY 1
+#define ASK_ERROR 2
+
+// display side
+void askclaude_request();             // conversation: buffer is turns split by ---
+// grammar review of the given text (a selection or a whole file):
+// rewrite=false lists the issues, rewrite=true returns corrected text
+void askclaude_review_request(const char *text, bool rewrite);
+int askclaude_status();               // ASK_IDLE / ASK_BUSY / ASK_ERROR
+const char *askclaude_status_text();  // short text for the status bar
+void askclaude_clear_error();         // dismiss an error state
+bool askclaude_answer_ready();        // a finished answer is waiting
+bool askclaude_answer_is_grammar();   // pending answer is a grammar report
+String askclaude_take_answer();       // consume the pending answer
+
+// background core (called from app_loop)
+void askclaude_loop();
diff --git a/micro-journal-rev-4-esp32/src/service/Crypt/Crypt.cpp b/micro-journal-rev-4-esp32/src/service/Crypt/Crypt.cpp
new file mode 100644
index 0000000..c4db2c3
--- /dev/null
+++ b/micro-journal-rev-4-esp32/src/service/Crypt/Crypt.cpp
@@ -0,0 +1,298 @@
+#include "Crypt.h"
+#include "app/app.h"
+
+#include <esp_system.h>
+#include "mbedtls/aes.h"
+#include "mbedtls/md.h"
+#include "mbedtls/pkcs5.h"
+
+// header layout: [0..7] magic, [8..23] salt, [24..55] SHA-256 of the key
+static const char CRYPT_MAGIC[8] = {'M', 'J', 'L', 'O', 'C', 'K', '0', '1'};
+#define SALT_SIZE 16
+#define VERIFIER_SIZE 32
+#define KEY_SIZE 32
+#define PBKDF2_ITERATIONS 6000
+
+// the one cached unlock
+static String _path = "";
+static bool _have_key = false;
+static uint8_t _key[KEY_SIZE];
+static uint8_t _salt[SALT_SIZE];
+
+//
+static bool sha256(const uint8_t *in, size_t len, uint8_t out[32])
+{
+    const mbedtls_md_info_t *info = mbedtls_md_info_from_type(MBEDTLS_MD_SHA256);
+    return info && mbedtls_md(info, in, len, out) == 0;
+}
+
+static bool derive_key(const char *password, const uint8_t salt[SALT_SIZE],
+                       uint8_t key[KEY_SIZE])
+{
+    const mbedtls_md_info_t *info = mbedtls_md_info_from_type(MBEDTLS_MD_SHA256);
+    if (!info)
+        return false;
+
+    mbedtls_md_context_t ctx;
+    mbedtls_md_init(&ctx);
+    if (mbedtls_md_setup(&ctx, info, 1) != 0)
+    {
+        mbedtls_md_free(&ctx);
+        return false;
+    }
+
+    int rc = mbedtls_pkcs5_pbkdf2_hmac(&ctx,
+                                       (const unsigned char *)password, strlen(password),
+                                       salt, SALT_SIZE,
+                                       PBKDF2_ITERATIONS, KEY_SIZE, key);
+    mbedtls_md_free(&ctx);
+    return rc == 0;
+}
+
+// read the header of an encrypted file; returns false when absent
+static bool read_header(const char *path, uint8_t salt[SALT_SIZE],
+                        uint8_t verifier[VERIFIER_SIZE])
+{
+    File file = gfs()->open(path, "r");
+    if (!file)
+        return false;
+
+    uint8_t header[CRYPT_HEADER_SIZE];
+    int n = file.read(header, CRYPT_HEADER_SIZE);
+    file.close();
+
+    if (n != CRYPT_HEADER_SIZE || memcmp(header, CRYPT_MAGIC, 8) != 0)
+        return false;
+
+    if (salt)
+        memcpy(salt, header + 8, SALT_SIZE);
+    if (verifier)
+        memcpy(verifier, header + 8 + SALT_SIZE, VERIFIER_SIZE);
+    return true;
+}
+
+bool crypt_is_encrypted(const char *path)
+{
+    return read_header(path, nullptr, nullptr);
+}
+
+bool crypt_unlocked_for(const char *path)
+{
+    return _have_key && _path == path;
+}
+
+void crypt_forget()
+{
+    memset(_key, 0, sizeof(_key));
+    memset(_salt, 0, sizeof(_salt));
+    _have_key = false;
+    _path = "";
+}
+
+size_t crypt_header(const char *path)
+{
+    // double-check the magic: a cleared/replaced file must never be read
+    // through the cipher just because a stale key is cached for its path
+    return (crypt_unlocked_for(path) && crypt_is_encrypted(path))
+               ? CRYPT_HEADER_SIZE
+               : 0;
+}
+
+bool crypt_unlock(const char *path, const char *password)
+{
+    uint8_t salt[SALT_SIZE], verifier[VERIFIER_SIZE];
+    if (!read_header(path, salt, verifier))
+        return false;
+
+    uint8_t key[KEY_SIZE], check[32];
+    if (!derive_key(password, salt, key))
+        return false;
+    if (!sha256(key, KEY_SIZE, check) || memcmp(check, verifier, VERIFIER_SIZE) != 0)
+    {
+        memset(key, 0, sizeof(key));
+        return false;
+    }
+
+    crypt_forget();
+    memcpy(_key, key, KEY_SIZE);
+    memcpy(_salt, salt, SALT_SIZE);
+    memset(key, 0, sizeof(key));
+    _path = path;
+    _have_key = true;
+
+    _log("[crypt] unlocked %s\n", path);
+    return true;
+}
+
+// XOR the AES-256-CTR keystream over buf at the given logical offset.
+// Counter block: 8 bytes of salt as the nonce + 64-bit big-endian block
+// index, so any offset can be reached directly.
+void crypt_apply(uint8_t *buf, size_t len, size_t offset)
+{
+    if (!_have_key || len == 0)
+        return;
+
+    mbedtls_aes_context aes;
+    mbedtls_aes_init(&aes);
+    mbedtls_aes_setkey_enc(&aes, _key, 256);
+
+    uint64_t block = offset / 16;
+    size_t within = offset % 16;
+    uint8_t counter[16], stream[16];
+
+    size_t i = 0;
+    while (i < len)
+    {
+        memcpy(counter, _salt, 8);
+        for (int b = 0; b < 8; b++)
+            counter[8 + b] = (uint8_t)(block >> (56 - 8 * b));
+        mbedtls_aes_crypt_ecb(&aes, MBEDTLS_AES_ENCRYPT, counter, stream);
+
+        while (within < 16 && i < len)
+            buf[i++] ^= stream[within++];
+
+        within = 0;
+        block++;
+    }
+
+    mbedtls_aes_free(&aes);
+}
+
+// stream src -> dst, XORing the keystream at logical offsets starting at
+// `logical` (used by protect/unprotect; encrypt and decrypt are the same
+// operation in CTR)
+static bool crypt_stream_copy(File &src, File &dst, size_t count, size_t logical)
+{
+    uint8_t chunk[512];
+    size_t done = 0;
+    while (done < count)
+    {
+        size_t want = count - done;
+        if (want > sizeof(chunk))
+            want = sizeof(chunk);
+        size_t n = src.read(chunk, want);
+        if (n == 0)
+            return false;
+        crypt_apply(chunk, n, logical + done);
+        if (dst.write(chunk, n) != n)
+            return false;
+        done += n;
+    }
+    return true;
+}
+
+// swap tmp into place, keeping the original on any failure
+static bool crypt_swap_in(const char *path, const String &tmp, bool ok)
+{
+    if (!ok)
+    {
+        gfs()->remove(tmp.c_str());
+        return false;
+    }
+    String bak = String(path) + ".old";
+    gfs()->remove(bak.c_str());
+    if (!gfs()->rename(path, bak.c_str()))
+        return false;
+    if (!gfs()->rename(tmp.c_str(), path))
+    {
+        gfs()->rename(bak.c_str(), path); // roll back
+        return false;
+    }
+    gfs()->remove(bak.c_str());
+    return true;
+}
+
+bool crypt_protect(const char *path, const char *password)
+{
+    if (crypt_is_encrypted(path) || password == nullptr || password[0] == '\0')
+        return false;
+
+    // fresh salt and key
+    uint8_t salt[SALT_SIZE], key[KEY_SIZE], verifier[32];
+    for (int i = 0; i < SALT_SIZE; i += 4)
+    {
+        uint32_t r = esp_random();
+        memcpy(salt + i, &r, 4);
+    }
+    if (!derive_key(password, salt, key) || !sha256(key, KEY_SIZE, verifier))
+        return false;
+
+    // cache the key first so crypt_apply uses it during the rewrite
+    crypt_forget();
+    memcpy(_key, key, KEY_SIZE);
+    memcpy(_salt, salt, SALT_SIZE);
+    memset(key, 0, sizeof(key));
+    _path = path;
+    _have_key = true;
+
+    File src = gfs()->open(path, "r");
+    if (!src)
+    {
+        crypt_forget();
+        return false;
+    }
+    size_t size = src.size();
+
+    String tmp = String(path) + ".tmp";
+    gfs()->remove(tmp.c_str());
+    File dst = gfs()->open(tmp.c_str(), "w");
+    bool ok = (bool)dst;
+
+    if (ok)
+    {
+        uint8_t header[CRYPT_HEADER_SIZE];
+        memcpy(header, CRYPT_MAGIC, 8);
+        memcpy(header + 8, salt, SALT_SIZE);
+        memcpy(header + 8 + SALT_SIZE, verifier, VERIFIER_SIZE);
+        ok = dst.write(header, CRYPT_HEADER_SIZE) == CRYPT_HEADER_SIZE;
+    }
+    if (ok)
+        ok = crypt_stream_copy(src, dst, size, 0);
+
+    src.close();
+    if (dst)
+        dst.close();
+
+    if (!crypt_swap_in(path, tmp, ok))
+    {
+        crypt_forget();
+        return false;
+    }
+
+    _log("[crypt] protected %s (%d bytes)\n", path, (int)size);
+    return true;
+}
+
+bool crypt_unprotect(const char *path)
+{
+    if (!crypt_unlocked_for(path))
+        return false;
+
+    File src = gfs()->open(path, "r");
+    if (!src)
+        return false;
+    size_t size = src.size();
+    if (size < CRYPT_HEADER_SIZE || !src.seek(CRYPT_HEADER_SIZE))
+    {
+        src.close();
+        return false;
+    }
+
+    String tmp = String(path) + ".tmp";
+    gfs()->remove(tmp.c_str());
+    File dst = gfs()->open(tmp.c_str(), "w");
+    bool ok = (bool)dst;
+    if (ok)
+        ok = crypt_stream_copy(src, dst, size - CRYPT_HEADER_SIZE, 0);
+
+    src.close();
+    if (dst)
+        dst.close();
+
+    if (!crypt_swap_in(path, tmp, ok))
+        return false;
+
+    crypt_forget();
+    _log("[crypt] unprotected %s\n", path);
+    return true;
+}
