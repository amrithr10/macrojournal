+static void WP_appendToBuffer(const char *text)
+{
+    Editor &editor = Editor::getInstance();
+
+    int size = editor.getBufferSize();
+    int room = BUFFER_SIZE - size - 1;
+    if (room <= 0)
+        return;
+
+    int len = strlen(text);
+    if (len > room)
+        len = room;
+
+    memcpy(editor.buffer + size, text, len);
