+    int start = selectionStart();
+    int end = selectionEnd();
+    int bufferSize = getBufferSize();
+
+    if (bufferSize > end)
+        memmove(buffer + start, buffer + end, bufferSize - end);
+
+    buffer[bufferSize - (end - start)] = '\0';
+    cursorPos = start;
+
+    clearSelection();
+    saved = false;
+    markDirty();
+
+    _debug("Editor::deleteSelection %d bytes at %d\n", end - start, start);
+}
+
+void Editor::selectAll()
+{
+    composer.reset();
