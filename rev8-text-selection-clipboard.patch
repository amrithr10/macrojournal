+++ b/micro-journal-rev-4-esp32/src/display/RLCD/Logo/Logo.h
@@ -0,0 +1,22 @@
+#pragma once
+
+#include "ST7305_4p2_BW_DisplayDriver.h"
+
+// The RighterDeck logo is Susan Kare's classic Happy Mac, rebuilt as 1-bit
+// pixel art. It is drawn straight from a list of rectangles (the panel's
+// native primitive) so it scales cleanly to any size without a bitmap blit.
+//
+//   happymac  - the full smiling compact Mac (About / boot mark)
+//   happymac_blank - the same silhouette with a blank screen, for the menu
+//                    bar where a face would just muddy at ~16px
+//
+// (x, y) is the top-left corner in panel pixels; scale multiplies the design
+// grid (happymac is 44x56 at scale 1, happymac_blank is 13x16).
+void logo_happymac(ST7305_4p2_BW_DisplayDriver *display, int x, int y, int scale);
+void logo_happymac_blank(ST7305_4p2_BW_DisplayDriver *display, int x, int y, int scale);
+
+// design-grid dimensions, so callers can centre/place the marks
+static const int LOGO_HAPPYMAC_W = 44;
+static const int LOGO_HAPPYMAC_H = 56;
+static const int LOGO_HAPPYMAC_BLANK_W = 14;
+static const int LOGO_HAPPYMAC_BLANK_H = 16;
diff --git a/micro-journal-rev-4-esp32/src/display/RLCD/Menu/About/About.cpp b/micro-journal-rev-4-esp32/src/display/RLCD/Menu/About/About.cpp
new file mode 100644
index 0000000..edeeaad
--- /dev/null
+++ b/micro-journal-rev-4-esp32/src/display/RLCD/Menu/About/About.cpp
@@ -0,0 +1,56 @@
+#include "About.h"
+#include "../Menu.h"
+#include "app/app.h"
+#include "display/display.h"
+
+#include "../../Logo/Logo.h"
+#include "../../MenuBar/MenuBar.h" // ui_print_tracked / UI_TRACK_CW
+
+void About_setup(ST7305_4p2_BW_DisplayDriver *display, U8G2_FOR_ST73XX *u8)
+{
+    // static content - just force one paint (Menu already cleared the screen)
+    Menu_clear();
+}
+
+void About_render(ST7305_4p2_BW_DisplayDriver *display, U8G2_FOR_ST73XX *u8)
+{
+    JsonDocument &app = status();
+    u8->setFont(u8g2_font_profont22_tf);
+
+    // big Happy Mac on the left (design grid 44x56 -> 88x112 at scale 2)
+    logo_happymac(display, 34, 60, 2);
+
+    // device name headline, tracked to match the rest of the UI
+    String title = app["config"]["title"].as<String>();
+    if (title == "null" || title.isEmpty())
+        title = "MacroJournal";
+    // keep the headline from overrunning the right edge
+    if (title.length() > 17)
+        title = title.substring(0, 17);
+    ui_print_tracked(u8, 140, 92, title.c_str(), UI_TRACK_CW);
+
+    // firmware line + version (plain 12px advance packs these narrower)
+    u8->setCursor(140, 122);
+    u8->print("Writerdeck firmware");
+    u8->setCursor(140, 148);
+    u8->print("Version ");
+    u8->print(VERSION);
+
+    // hairline, then the upstream credit below the whole block
+    display->drawLine(34, 176, 380, 176, 1);
+    u8->setCursor(34, 202);
+    u8->print("Built on Micro Journal Rev 8");
+    u8->setCursor(34, 226);
+    u8->print("by unkyulee");
+
+    // footer hint
+    display->drawLine(0, 256, 400, 256, 1);
+    ui_print_tracked(u8, 116, 282, "Press ESC to exit", UI_TRACK_CW);
+}
+
+void About_keyboard(char key)
+{
+    // Esc / MENU are caught by the generic sub-screen handler in Menu_keyboard
+    // (returns to the home menu, or to the note it was opened from); every
+    // other key is ignored so a stray press doesn't do anything surprising.
+}
