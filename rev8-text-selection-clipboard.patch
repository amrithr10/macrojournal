+//
+// SELECTION AND CLIPBOARD
+//
+
+void Editor::clearSelection()
+{
+    // only flag a repaint when there was actually something to clear -
+    // plain cursor keys call this on every press
+    if (selectAnchor >= 0)
+        selectionChanged = true;
+
+    selectAnchor = -1;
+}
+
+// Remove the selected bytes from the buffer and leave the cursor where the
+// selection began.
+void Editor::deleteSelection()
+{
+    if (!hasSelection())
+    {
+        clearSelection();
+        return;
+    }
+
+    int start = selectionStart();
+    int end = selectionEnd();
+    int bufferSize = getBufferSize();
+
+    if (bufferSize > end)
+        memmove(buffer + start, buffer + end, bufferSize - end);
+
+    buffer[bufferSize - (end - start)] = '\0';
+    cursorPos = start;
+
+    clearSelection();
+    saved = false;
+    markDirty();
+
+    _debug("Editor::deleteSelection %d bytes at %d\n", end - start, start);
+}
+
+void Editor::selectAll()
+{
+    composer.reset();
+
+    selectAnchor = 0;
+    cursorPos = getBufferSize();
+    selectionChanged = true;
+}
+
+void Editor::copySelection()
+{
+    if (!hasSelection())
+        return;
+
+    int start = selectionStart();
+    int len = selectionEnd() - start;
+
+    if (len > CLIPBOARD_SIZE - 1)
+    {
+        len = CLIPBOARD_SIZE - 1;
+        // never truncate in the middle of a UTF-8 character
+        while (len > 0 && utf8_is_continuation((uint8_t)buffer[start + len]))
+            len--;
+    }
+
+    memcpy(clipboard, buffer + start, len);
+    clipboard[len] = '\0';
+
+    _debug("Editor::copySelection %d bytes\n", len);
+}
+
+void Editor::cutSelection()
+{
+    if (!hasSelection())
+        return;
+
+    copySelection();
+    deleteSelection();
+}
+
+// Insert the clipboard at the cursor, replacing the selection if there is
+// one. If the window can't hold the insert, flush it first exactly like
+// typing does when the buffer fills up.
+void Editor::paste()
+{
+    int len = strlen(clipboard);
+    if (len == 0)
+        return;
+
+    composer.reset();
+
+    if (hasSelection())
+        deleteSelection();
+
+    // same flush rule as typing: make sure the insert fits in the window
+    if (getBufferSize() + len + 4 >= BUFFER_SIZE)
+        advanceWindow();
+
+    int bufferSize = getBufferSize();
+    if (bufferSize + len >= (int)sizeof(buffer) - 1)
+    {
+        // advanceWindow failed to free space (e.g. save error) - don't
+        // paste partially
+        _log("Editor::paste: no room to paste %d bytes\n", len);
+        return;
+    }
+
+    if (bufferSize > cursorPos)
+        memmove(buffer + cursorPos + len, buffer + cursorPos, bufferSize - cursorPos);
+
+    memcpy(buffer + cursorPos, clipboard, len);
+    buffer[bufferSize + len] = '\0';
+    cursorPos += len;
+
+    saved = false;
+    markDirty();
+
+    _debug("Editor::paste %d bytes at %d\n", len, cursorPos - len);
+}
+
+// Wrap the selection in emphasis markers ("**" bold, "*" italic). With no
+// selection, insert an empty marker pair and leave the cursor between the
+// markers, ready to type styled text.
+void Editor::wrapSelection(const char *marker)
+{
+    int mlen = strlen(marker);
+    int bufferSize = getBufferSize();
+    if (bufferSize + 2 * mlen >= (int)sizeof(buffer) - 1)
+        return;
+
+    composer.reset();
