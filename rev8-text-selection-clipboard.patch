+            file_titles[i][sizeof(file_titles[0]) - 1] = '\0';
+            continue;
+        }
+        File file = gfs()->open(path.c_str(), "r");
+        if (!file)
+            continue;
+        char raw[64];
+        int n = file.read((uint8_t *)raw, sizeof(raw) - 1);
+        file.close();
+        if (n <= 0)
+            continue;
+        raw[n] = '\0';
