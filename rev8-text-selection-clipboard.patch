+// ---- named sync ---------------------------------------------------------
+// percent-encode a display name for the sync URL's ?name= parameter
+static String sync_urlencode(const String &s)
+{
+    static const char *hex = "0123456789ABCDEF";
+    String out;
+    for (size_t i = 0; i < s.length(); i++)
+    {
+        uint8_t b = (uint8_t)s[i];
+        if ((b >= 'A' && b <= 'Z') || (b >= 'a' && b <= 'z') ||
+            (b >= '0' && b <= '9') || b == '-' || b == '_' || b == '.' || b == '~')
+            out += (char)b;
+        else
+        {
+            out += '%';
+            out += hex[(b >> 4) & 0xF];
+            out += hex[b & 0xF];
+        }
+    }
+    return out;
+}
