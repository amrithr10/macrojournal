diff --git a/micro-journal-rev-4-esp32/src/display/RLCD/Logo/Logo.cpp b/micro-journal-rev-4-esp32/src/display/RLCD/Logo/Logo.cpp
new file mode 100644
index 0000000..2c91e1a
--- /dev/null
+++ b/micro-journal-rev-4-esp32/src/display/RLCD/Logo/Logo.cpp
@@ -0,0 +1,72 @@
+#include "Logo.h"
+
+// A logo is an ordered list of solid rectangles on the design grid. They are
+// painted in order, ink (1) laying down black mass and panel (0) carving the
+// white cut-outs back out (screen, disk slot, rounded corners) - exactly the
+// layering of the approved mockup.
+struct LogoRect
+{
+    uint8_t x, y, w, h;
+    uint8_t ink; // 1 = ST7305_COLOR_BLACK, 0 = ST7305_COLOR_WHITE
+};
+
+// --- Happy Mac, 44 x 56, with face ---------------------------------------
+static const LogoRect HAPPYMAC[] = {
+    // body mass
+    {6, 4, 32, 40, 1},
+    // rounded top corners + white interior
+    {6, 4, 2, 2, 0}, {36, 4, 2, 2, 0}, {8, 6, 28, 36, 0},
+    // screen frame + detached base (ink)
+    {11, 9, 22, 20, 1}, {9, 47, 26, 7, 1},
+    // screen glass + rounded screen corners + base interior (white)
+    {13, 11, 18, 16, 0},
+    {11, 9, 1, 1, 0}, {32, 9, 1, 1, 0}, {11, 28, 1, 1, 0}, {32, 28, 1, 1, 0},
+    {11, 49, 22, 3, 0},
+    // face: eyes
+    {17, 15, 3, 2, 1}, {25, 15, 3, 2, 1},
+    // face: nose
+    {21, 16, 2, 3, 1}, {19, 20, 4, 1, 1},
+    // face: smile
+    {17, 23, 2, 1, 1}, {18, 24, 2, 1, 1}, {20, 25, 5, 1, 1},
+    {24, 24, 2, 1, 1}, {26, 23, 2, 1, 1},
+    // lower-left mark + floppy slot
+    {13, 38, 3, 1, 1}, {24, 37, 7, 2, 1},
+};
+
+// --- Happy Mac, 13 x 16, blank screen (menu bar) -------------------------
+static const LogoRect HAPPYMAC_BLANK[] = {
+    {1, 1, 12, 14, 1},                 // body
+    {1, 1, 1, 1, 0}, {12, 1, 1, 1, 0}, // rounded top corners
+    {2, 2, 10, 12, 0},                 // white interior (1px body frame)
+    {3, 3, 8, 6, 1},                   // screen bezel (2px dark frame...)
+    {5, 5, 4, 2, 0},                   // ...with a light screen inside
+    {4, 11, 6, 2, 1},                  // disk slot
+};
+
+static void logo_draw(ST7305_4p2_BW_DisplayDriver *display, const LogoRect *rects,
+                      int count, int x, int y, int scale)
+{
+    if (scale < 1)
+        scale = 1;
+    for (int i = 0; i < count; i++)
+    {
+        const LogoRect &r = rects[i];
+        int x1 = x + r.x * scale;
+        int y1 = y + r.y * scale;
+        int x2 = x1 + r.w * scale - 1;
+        int y2 = y1 + r.h * scale - 1;
+        display->drawFilledRectangle(x1, y1, x2, y2,
+                                     r.ink ? ST7305_COLOR_BLACK : ST7305_COLOR_WHITE);
+    }
+}
+
+void logo_happymac(ST7305_4p2_BW_DisplayDriver *display, int x, int y, int scale)
+{
+    logo_draw(display, HAPPYMAC, sizeof(HAPPYMAC) / sizeof(HAPPYMAC[0]), x, y, scale);
+}
+
+void logo_happymac_blank(ST7305_4p2_BW_DisplayDriver *display, int x, int y, int scale)
+{
+    logo_draw(display, HAPPYMAC_BLANK,
+              sizeof(HAPPYMAC_BLANK) / sizeof(HAPPYMAC_BLANK[0]), x, y, scale);
+}
diff --git a/micro-journal-rev-4-esp32/src/display/RLCD/Logo/Logo.h b/micro-journal-rev-4-esp32/src/display/RLCD/Logo/Logo.h
