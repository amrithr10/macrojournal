@@ -0,0 +1,37 @@
+#pragma once
+
+#include <Arduino.h>
+
+// Per-file password encryption (Rev 8).
+//
+// Encrypted files carry a 56-byte header (magic, salt, key verifier)
+// followed by AES-256-CTR ciphertext of the text. CTR keystream position
+// is the LOGICAL text offset, so the editor's windowed random access
+// works unchanged: the editor shifts physical offsets by the header size
+// and XORs the keystream at the logical offset on every read/write.
+// Plaintext never touches the disk.
+//
+// The key for at most ONE file at a time is cached in RAM after a
+// successful unlock; switching to a different file forgets it.
+//
+// FORGOTTEN PASSWORD = FILE UNRECOVERABLE. There is no reset.
+
+#define CRYPT_HEADER_SIZE 56
+
+bool crypt_is_encrypted(const char *path); // file starts with the magic?
+bool crypt_unlocked_for(const char *path); // key cached for this path?
+bool crypt_unlock(const char *path, const char *password); // verify + cache
+void crypt_forget();                       // wipe the cached key
+
+// header size for offset math: CRYPT_HEADER_SIZE when the CURRENT cached
+// path matches and is encrypted, else 0
+size_t crypt_header(const char *path);
+
+// XOR the CTR keystream over buf. offset is the LOGICAL text offset.
+void crypt_apply(uint8_t *buf, size_t len, size_t offset);
+
+// encrypt / decrypt a whole file in place (atomic via tmp + rename).
+// protect caches the key (the file stays open); unprotect requires the
+// file to be unlocked already.
+bool crypt_protect(const char *path, const char *password);
+bool crypt_unprotect(const char *path);
