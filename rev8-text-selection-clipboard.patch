+
+// Classic-Mac Finder home in two zones: three raised, beveled tool tiles
+// (Scratch / Gramma / Last) on top and a titled notes window below, over a
+// light grey desktop. Selection is shown with a box (text stays black on
+// white). Left/Right move across tools, Down drops into notes, Up from the
+// top note returns; the notes list wraps (Down past the end -> top).
+#define NOTE_VIS 6
+#define K_LEFT 18
+#define K_RIGHT 19
+#define K_UP 20
+#define K_DOWN 21
+
+static int sel_zone = 1; // 0 = tools, 1 = notes
+static int tool_sel = 0;
+static int note_row = 0;
+static int note_scroll = 0;
