diff --git a/micro-journal-rev-4-esp32/src/display/RLCD/Menu/FreeSpace/FreeSpace.cpp b/micro-journal-rev-4-esp32/src/display/RLCD/Menu/FreeSpace/FreeSpace.cpp
new file mode 100644
index 0000000..9896140
--- /dev/null
+++ b/micro-journal-rev-4-esp32/src/display/RLCD/Menu/FreeSpace/FreeSpace.cpp
@@ -0,0 +1,121 @@
+#include "FreeSpace.h"
+#include "../Menu.h"
+#include "app/app.h"
+#include "display/display.h"
+
+#include "../../MenuBar/MenuBar.h" // ui_print_tracked / UI_TRACK_CW
+
+// snapshot taken at setup so the numbers hold still while the box is open
+static size_t s_total = 0, s_used = 0;
+static int s_notes = 0;
+
+// grey via 50% checkerboard (same phase as the home desktop)
+static void fs_dither(ST7305_4p2_BW_DisplayDriver *d, int x0, int y0, int x1, int y1)
+{
+    for (int y = y0; y <= y1; y++)
+        for (int x = x0; x <= x1; x++)
+            if ((x + y) & 1)
+                d->writePoint((uint)x, (uint)y, true);
+}
+
+// bytes -> a compact human string (MB with 2 decimals, else KB, else bytes)
+static String human(size_t b)
+{
+    char buf[24];
+    if (b >= 1024UL * 1024UL)
+        snprintf(buf, sizeof(buf), "%.2f MB", (double)b / (1024.0 * 1024.0));
+    else if (b >= 1024UL)
+        snprintf(buf, sizeof(buf), "%u KB", (unsigned)(b / 1024UL));
+    else
+        snprintf(buf, sizeof(buf), "%u B", (unsigned)b);
+    return String(buf);
+}
+
+// a small hard-disk icon
+static void disk_icon(ST7305_4p2_BW_DisplayDriver *d, int x, int y)
+{
+    d->drawRectangle(x, y, x + 32, y + 22, 1);
+    d->drawLine(x + 2, y + 15, x + 30, y + 15, 1);
+    d->drawFilledRectangle(x + 24, y + 18, x + 28, y + 20, 1); // activity LED
+}
+
+void FreeSpace_setup(ST7305_4p2_BW_DisplayDriver *display, U8G2_FOR_ST73XX *u8)
+{
+    s_total = gfs()->totalBytes();
+    s_used = gfs()->usedBytes();
+
+    s_notes = 0;
+    for (int i = 0; i < 10; i++)
+    {
+        String p = format("/%d.txt", i);
+        if (!gfs()->exists(p.c_str()))
+            continue;
+        File f = gfs()->open(p.c_str(), "r");
+        bool used = f && f.size() > 0;
+        if (f)
+            f.close();
+        if (used)
+            s_notes++;
+    }
+
+    Menu_clear();
+}
+
+void FreeSpace_render(ST7305_4p2_BW_DisplayDriver *display, U8G2_FOR_ST73XX *u8)
+{
+    u8->setFont(u8g2_font_profont22_tf);
+
+    // dithered desktop behind the box
+    fs_dither(display, 0, 0, 399, 299);
+
+    const int bx = 46, by = 48, bw = 308, bh = 204;
+
+    // white box with a black frame
+    display->drawFilledRectangle(bx, by, bx + bw, by + bh, 0);
+    display->drawRectangle(bx, by, bx + bw, by + bh, 1);
+
+    // striped classic title bar with a centred "Storage" plate
+    for (int sy = by + 4; sy <= by + 16; sy += 3)
+        display->drawLine(bx + 3, sy, bx + bw - 3, sy, 1);
+    const char *tt = "Storage";
+    int plate_w = (int)strlen(tt) * UI_TRACK_CW + 16;
+    int plate_x = (bx + bx + bw - plate_w) / 2;
+    display->drawFilledRectangle(plate_x, by + 2, plate_x + plate_w, by + 20, 0);
+    ui_print_tracked(u8, plate_x + 8, by + 18, tt, UI_TRACK_CW);
+    display->drawLine(bx, by + 22, bx + bw, by + 22, 1);
+
+    // disk icon + label
+    disk_icon(display, bx + 20, by + 36);
+    ui_print_tracked(u8, bx + 62, by + 54, "Internal disk", UI_TRACK_CW);
+
+    // usage gauge
+    size_t freeb = s_total > s_used ? s_total - s_used : 0;
+    int pct = s_total ? (int)(((uint64_t)s_used * 100) / s_total) : 0;
+
+    int gx0 = bx + 20, gx1 = bx + bw - 20, gy0 = by + 70, gy1 = by + 90;
+    display->drawRectangle(gx0, gy0, gx1, gy1, 1);
+    int inner = gx1 - gx0 - 4;
+    int fillw = s_total ? (int)(((uint64_t)inner * s_used) / s_total) : 0;
+    if (fillw > 0)
+        display->drawFilledRectangle(gx0 + 2, gy0 + 2, gx0 + 2 + fillw, gy1 - 2, 1);
+
+    // figures
+    char line[40];
+    int ty = by + 116;
+    ui_print_tracked(u8, gx0, ty, ("Total  " + human(s_total)).c_str(), UI_TRACK_CW);
+    snprintf(line, sizeof(line), "Used   %s  (%d%%)", human(s_used).c_str(), pct);
+    ui_print_tracked(u8, gx0, ty + 24, line, UI_TRACK_CW);
+    ui_print_tracked(u8, gx0, ty + 48, ("Free   " + human(freeb)).c_str(), UI_TRACK_CW);
+    snprintf(line, sizeof(line), "Notes  %d of 10", s_notes);
+    ui_print_tracked(u8, gx0, ty + 72, line, UI_TRACK_CW);
+
+    // footer hint on a small plate so it stays legible over the dither
+    display->drawFilledRectangle(120, by + bh + 6, 280, by + bh + 26, 0);
+    ui_print_tracked(u8, 132, by + bh + 21, "Press ESC to exit", UI_TRACK_CW);
+}
+
+void FreeSpace_keyboard(char key)
+{
+    // Esc / MENU handled by the generic sub-screen handler in Menu_keyboard;
+    // other keys ignored.
+}
