+static void home_load_titles()
+{
+    for (int i = 0; i < 10; i++)
+    {
+        file_titles[i][0] = '\0';
+        file_locked[i] = false;
+
+        String path = format("/%d.txt", i);
+        if (!gfs()->exists(path.c_str()))
+            continue;
+        if (crypt_is_encrypted(path.c_str()))
+        {
+            file_locked[i] = true;
+            strcpy(file_titles[i], "LOCKED");
+            continue;
+        }
+        // a user-given name wins over the first-line preview
+        String nm = note_name(i);
+        if (!nm.isEmpty())
+        {
