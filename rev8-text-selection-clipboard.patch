+// activate and drop the first menu. in_note selects the editor vs home host
+// (they dispatch a little differently); target_note is the note the File
+// menu's Lock/Clear act on - the open note in the editor, or the selected
+// row on the home screen (-1 when the selection isn't a real note 0-9).
+void menubar_open(bool in_note, int target_note);
+void menubar_close();
+bool menubar_active();
+
+// bumps on every visible state change (open/close/navigate) so the host's
+// needs-display check knows to push a frame
+int menubar_serial();
+
+// feed one key while the bar is active; returns one of the MB_* codes
+int menubar_key(int key);
+
+// draw the bar and the open dropdown over the current screen
+void menubar_render(ST7305_4p2_BW_DisplayDriver *display, U8G2_FOR_ST73XX *u8);
+
+// Shared text helper: draw a string on a fixed per-character cell pitch
+// (tracking) so wide monospace glyphs (m, a, w) get a gap instead of
+// touching. Used by both the dropdown items and the home-screen body text so
+// the whole UI reads the same. UI_TRACK_CW is that pitch (profont22's native
+// advance is 12; +2 opens the letters up).
+static const int UI_TRACK_CW = 14;
+void ui_print_tracked(U8G2_FOR_ST73XX *u8, int x, int y, const char *s, int cw);
