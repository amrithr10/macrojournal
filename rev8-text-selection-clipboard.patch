+static void WP_appendToBuffer(const char *text)
+{
+    Editor &editor = Editor::getInstance();
+
+    int size = editor.getBufferSize();
+    int room = BUFFER_SIZE - size - 1;
+    if (room <= 0)
+        return;
+
+    int len = strlen(text);
+    if (len > room)
+        len = room;
+
+    memcpy(editor.buffer + size, text, len);
+    editor.buffer[size + len] = '\0';
+
+    editor.cursorPos = editor.getBufferSize();
+    editor.saved = false;
+    editor.markDirty(); // the injected answer becomes its own undo step
+    editor.pageChanged = true; // full redraw
+    editor.updateScreen();
