+#include "NoteNames.h"
+
+#include "app/app.h"
+#include "app/Config/Config.h"
+
+String note_name(int slot)
+{
+    if (slot < 0 || slot > 9)
+        return "";
+    JsonDocument &app = status();
+    String key = String(slot);
+    if (!app["config"]["names"][key].is<const char *>())
+        return "";
+    return app["config"]["names"][key].as<String>();
+}
+
+void note_name_set(int slot, const String &name)
+{
+    if (slot < 0 || slot > 9)
+        return;
+    JsonDocument &app = status();
+    String key = String(slot);
+
+    String trimmed = name;
+    trimmed.trim();
+    if (trimmed.isEmpty())
+        app["config"]["names"].remove(key);
+    else
+        app["config"]["names"][key] = trimmed;
+
+    config_save();
+}
