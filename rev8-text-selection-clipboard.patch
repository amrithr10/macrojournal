+    static const int UNDO_MAX = 10;       // at most 10 undo steps
+    static const int UNDO_BUDGET = 16000; // bytes per stack (secondary cap)
+
+    UndoState undoStack[UNDO_MAX];
+    UndoState redoStack[UNDO_MAX];
+    int undoCount = 0;
+    int redoCount = 0;
+    size_t undoBytes = 0;
+    size_t redoBytes = 0;
+
+    // the committed state the next edit burst is measured against
+    char *undoBaseline = nullptr;
+    int undoBaselineLen = 0;
+    int undoBaselineCursor = 0;
+    bool undoDirty = false;
+    unsigned long undoLastEdit = 0;
+
+    char *historyDup(const char *src, int len);
+    void historyPush(UndoState *stack, int &count, size_t &bytes,
+                     char *text, int len, int cursor);
+    void historyClearStack(UndoState *stack, int &count, size_t &bytes);
+    void historyRestore(const char *text, int len, int cursor);
 };
