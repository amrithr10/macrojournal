+
+// Open a file, prompting for its password when it is protected and not
+// yet unlocked. Leaving the current file forgets its key.
+void WP_openFileGuarded(int fileIndex)
+{
+    String path = format("/%d.txt", fileIndex);
+
+    // flush the current file while its key (if any) is still cached
+    Editor::getInstance().saveFile();
+
+    if (!crypt_unlocked_for(path.c_str()))
+        crypt_forget();
+
+    if (crypt_is_encrypted(path.c_str()) && !crypt_unlocked_for(path.c_str()))
+    {
+        WP_promptPassword(PW_UNLOCK, fileIndex);
+        return;
+    }
+
+    WP_switchToFile(fileIndex);
+}
