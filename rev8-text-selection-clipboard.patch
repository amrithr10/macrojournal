+// File traverse mode ([F]): -1 = off, else the highlighted file 0..9.
+// Arrows move the highlight; Enter opens it, D clears it, P manages its
+// password - each action makes the highlighted file the active file
+// first, so the existing confirmation and password flows apply.
+static int traverse = -1;
+
+// Traverse mode is sticky: acting on a file (or visiting one) and coming
+// back to the menu restores the highlight on the file you came from.
+// Only ESC or F turn it off.
+static bool traverse_stick = false;
+
+// First line of each file, shown as its title in the file list. Loaded
+// when the home screen opens; 10 tiny reads are instant on the FAT.
+static char file_titles[10][14];
+
+static void home_load_titles()
+{
+    for (int i = 0; i < 10; i++)
+    {
+        file_titles[i][0] = '\0';
+
+        String path = format("/%d.txt", i);
+        if (!gfs()->exists(path.c_str()))
+            continue;
+
+        // protected files never leak their first line
+        if (crypt_is_encrypted(path.c_str()))
+        {
+            strcpy(file_titles[i], "LOCKED");
+            continue;
+        }
+
+        File file = gfs()->open(path.c_str(), "r");
+        if (!file)
+            continue;
+
+        char raw[64];
+        int n = file.read((uint8_t *)raw, sizeof(raw) - 1);
+        file.close();
+        if (n <= 0)
+            continue;
+        raw[n] = '\0';
+
+        // skip leading whitespace and markdown markers so the title reads
+        // clean even when the note starts with "> " or "**"
+        char *psrc = raw;
+        while (*psrc == ' ' || *psrc == '\n' || *psrc == '\r' ||
+               *psrc == '>' || *psrc == '#' || *psrc == '*')
+            psrc++;
+
+        // copy the rest of the first line, whole UTF-8 characters only
+        int out = 0;
+        while (*psrc && *psrc != '\n' && *psrc != '\r')
+        {
+            uint8_t b = (uint8_t)*psrc;
+            int len = 1;
+            if ((b & 0xE0) == 0xC0) len = 2;
+            else if ((b & 0xF0) == 0xE0) len = 3;
+            else if ((b & 0xF8) == 0xF0) len = 4;
+
+            if (out + len > (int)sizeof(file_titles[0]) - 1)
+                break;
+
+            // the 64-byte probe may end mid-character - stop cleanly
+            bool complete = true;
+            for (int k = 1; k < len; k++)
+                if (((uint8_t)psrc[k] & 0xC0) != 0x80)
+                {
+                    complete = false;
+                    break;
+                }
+            if (!complete)
+                break;
+
+            for (int k = 0; k < len; k++)
+                file_titles[i][out++] = psrc[k];
+            psrc += len;
+        }
+        file_titles[i][out] = '\0';
+    }
+}
 
