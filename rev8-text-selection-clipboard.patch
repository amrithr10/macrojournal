+    // insert the closing marker first so the start offset stays valid
+    memmove(buffer + end + mlen, buffer + end, bufferSize - end + 1); // +1 NUL
+    memcpy(buffer + end, marker, mlen);
+    bufferSize += mlen;
+    memmove(buffer + start + mlen, buffer + start, bufferSize - start + 1);
+    memcpy(buffer + start, marker, mlen);
+
+    // after wrapping a selection the cursor lands after the closing marker;
+    // with no selection it lands between the pair
+    cursorPos = hadSelection ? end + 2 * mlen : start + mlen;
+
+    clearSelection();
+    saved = false;
+    markDirty();
+    selectionChanged = true; // markers appear mid-line - full repaint
+
+    _debug("Editor::wrapSelection '%s' at %d..%d\n", marker, start, end);
+}
