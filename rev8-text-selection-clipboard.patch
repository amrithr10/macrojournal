+            for (int k = 1; k < len; k++)
+                if (((uint8_t)psrc[k] & 0xC0) != 0x80)
+                {
+                    complete = false;
+                    break;
+                }
+            if (!complete)
+                break;
+            for (int k = 0; k < len; k++)
+                file_titles[i][out++] = psrc[k];
+            psrc += len;
+        }
+        file_titles[i][out] = '\0';
+    }
+}
 
