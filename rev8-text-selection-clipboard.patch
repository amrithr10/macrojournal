+    // nothing actually changed (e.g. typed then deleted back to baseline)
+    if (undoBaseline && strcmp(undoBaseline, buffer) == 0)
+    {
+        undoDirty = false;
+        return;
+    }
+
+    // the pre-burst baseline becomes an undo step (ownership transferred)
+    if (undoBaseline)
+        historyPush(undoStack, undoCount, undoBytes,
+                    undoBaseline, undoBaselineLen, undoBaselineCursor);
+
+    // a fresh edit invalidates the redo history
+    historyClearStack(redoStack, redoCount, redoBytes);
+
+    // new baseline is the current buffer
+    int len = getBufferSize();
+    undoBaseline = historyDup(buffer, len);
+    undoBaselineLen = undoBaseline ? len : 0;
+    undoBaselineCursor = cursorPos;
+    undoDirty = false;
+}
+
+void Editor::undo()
+{
+    // flush any in-progress burst so it becomes its own undo step first
+    historyCommit();
+
+    if (undoCount == 0)
+        return;
+
+    // current state goes onto the redo stack
+    int curLen = getBufferSize();
+    historyPush(redoStack, redoCount, redoBytes,
+                historyDup(buffer, curLen), curLen, cursorPos);
+
+    // pop the previous state and restore it
+    UndoState s = undoStack[--undoCount];
+    undoBytes -= s.len;
+    historyRestore(s.text, s.len, s.cursorPos);
+    free(s.text);
+
+    // baseline follows the buffer
+    free(undoBaseline);
+    int len = getBufferSize();
+    undoBaseline = historyDup(buffer, len);
+    undoBaselineLen = undoBaseline ? len : 0;
+    undoBaselineCursor = cursorPos;
+    undoDirty = false;
+
+    saved = false;
+    pageChanged = true; // full redraw
+    updateScreen();
+}
+
+void Editor::redo()
+{
+    // a pending edit invalidates redo - committing it clears the stack
+    historyCommit();
+
+    if (redoCount == 0)
+        return;
+
+    // current state goes back onto the undo stack
+    int curLen = getBufferSize();
+    historyPush(undoStack, undoCount, undoBytes,
+                historyDup(buffer, curLen), curLen, cursorPos);
+
+    UndoState s = redoStack[--redoCount];
+    redoBytes -= s.len;
+    historyRestore(s.text, s.len, s.cursorPos);
+    free(s.text);
+
+    free(undoBaseline);
+    int len = getBufferSize();
+    undoBaseline = historyDup(buffer, len);
+    undoBaselineLen = undoBaseline ? len : 0;
+    undoBaselineCursor = cursorPos;
+    undoDirty = false;
+
+    saved = false;
+    pageChanged = true;
+    updateScreen();
+}
